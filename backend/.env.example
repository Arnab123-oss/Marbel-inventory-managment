PORT=3000
NODE_ENV=development
SESSION_SECRET=

# Main Database: MongoDB Atlas Connection String (via Mongoose)
# Example: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/stonepulse?retryWrites=true&w=majority
MONGODB_URI=

# Optional Firebase Services (Authentication + Product/Slab Image Storage)
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_SERVICE_ACCOUNT_JSON=

# Optional CORS allowed origins (comma-separated)
CORS_ORIGIN=
